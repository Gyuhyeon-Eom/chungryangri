# 이 파일을 .env 로 복사한 뒤 실제 키를 채워넣으세요. (.env 는 git에 올라가지 않습니다)

# 서울 열린데이터광장 — https://data.seoul.go.kr  (로그인 > 인증키 신청, 즉시 발급)
SEOUL_API_KEY=

# 공공데이터포털 — https://www.data.go.kr  (활용신청 후 발급, 일부는 승인 대기 필요)
DATA_GO_KR_KEY=

# SGIS 통계지리정보서비스 — https://sgis.kostat.go.kr/developer  (서비스 등록 후 발급)
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
